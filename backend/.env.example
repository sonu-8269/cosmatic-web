# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CLIENT_STOREFRONT_URL=http://localhost:3000
CLIENT_ADMIN_URL=http://localhost:5173
CLIENT_TEAM_URL=http://localhost:5174

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/cosmatics_db

# Security & JWT Tokens
JWT_ACCESS_SECRET=super_secret_access_jwt_key_cosmatics_32_chars_min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_cosmatics_64_chars_min
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=cosmatics_secure_cookie_signer_secret

# Default Super Admin (Used for seed script)
DEFAULT_ADMIN_NAME="Super Admin"
DEFAULT_ADMIN_EMAIL=admin@cosmatics.com
DEFAULT_ADMIN_PASSWORD=Admin@Cosmetics2026!

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5

# SMS Provider (MSG91)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id
MSG91_SENDER_ID=COSMTC

# Email Provider (Nodemailer / Brevo / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Cosmetics Store <noreply@cosmatics.com>"

# Cloudinary (Media Upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payment (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
